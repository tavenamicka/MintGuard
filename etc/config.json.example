{
  "app": {
    "language": "auto",
    "locale_fallback": "en",
    "theme": "auto"
  },
  "database": {
    "path": "/var/lib/mintguard/mintguard.db"
  },
  "dns": {
    "enabled": true,
    "listen_port": 5353,
    "blocklist_path": "/var/lib/mintguard/blocklist.hosts"
  },
  "monitoring": {
    "process_check_interval": 5,
    "session_check_interval": 60
  },
  "logging": {
    "level": "INFO",
    "path": "/var/log/mintguard/"
  }
}
