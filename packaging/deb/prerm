#!/usr/bin/env bash
# prerm du paquet mintguard : arrete le service AVANT que dpkg ne retire
# le venv et l'unite systemd (evite un service qui pointe sur des fichiers
# a moitie supprimes pendant un remove/upgrade).
set -euo pipefail

case "$1" in
  remove|upgrade|deconfigure)
    if systemctl is-active --quiet mintguard-daemon 2>/dev/null; then
      systemctl stop mintguard-daemon
    fi
    systemctl disable mintguard-daemon 2>/dev/null || true
    ;;
esac

# Desinstallation (pas une mise a jour) : rendre le DNS de la machine a son etat
# d'origine tant que le script de rollback est encore present. Sans cela, apres
# une purge, dnsmasq (toujours resolveur systeme) ne trouverait plus sa blocklist
# et refuserait de demarrer : plus aucune resolution DNS sur la machine.
case "$1" in
  remove|deconfigure)
    if [ -d /var/lib/mintguard/dns-switch-backup ] && [ -x /usr/lib/mintguard/switch-dns-rollback.sh ]; then
      /usr/lib/mintguard/switch-dns-rollback.sh || echo "Rollback DNS incomplet - voir /usr/lib/mintguard/switch-dns-rollback.sh" >&2
      rm -rf /var/lib/mintguard/dns-switch-backup
    fi
    ;;
esac

exit 0
